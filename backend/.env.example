# Flask Application Environment
FLASK_ENV=development
DEBUG=True
BEHIND_PROXY=false
PUBLIC_DOMAIN=localhost:8000
SESSION_COOKIE_SECURE=false

# Database Configuration
# Set DB_TYPE to 'sqlite' for zero-config portable run (uses backend/primeproperty.db)
# Or set DB_TYPE to 'mysql' to connect to your local MySQL / cPanel server
DB_TYPE=mysql

# MySQL Settings (used if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DB=primeproperty_v2

# MySQL Connection Pooling (Safe for cPanel limits)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=280

# Security
SECRET_KEY=primeproperty-ultra-luxury-secret-key-2026

