# ==============================================================================
# Backend .gitignore - Python Flask & SQLAlchemy Environment
# ==============================================================================

# Python Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Byte-compiled / Optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.pyo

# Environment Variables & Secrets
.env
.env.local
.env.*.local
*.env
!.env.example

# SQLite & Binary Database Files (Ensure .db files are never tracked)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Logs & Process IDs
*.log
logs/
*.pid

# Unit Test & Coverage
.coverage
htmlcov/
.pytest_cache/
.tox/
.nox/

# Operating System & Editor Files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
